# ─────────────────────────────────────────────────────
# Database (PostgreSQL)
# ─────────────────────────────────────────────────────
DATABASE_URL="postgresql://grc:grc_password@localhost:5432/grc_db"

# ─────────────────────────────────────────────────────
# Session encryption secret (min 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ─────────────────────────────────────────────────────
SESSION_SECRET="change-me-to-a-random-32-char-secret"

# ─────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─────────────────────────────────────────────────────
# Initial admin account (used by seed script on first run)
# ─────────────────────────────────────────────────────
ADMIN_EMAIL="admin@local"
ADMIN_PASSWORD="ChangeMe123!"
