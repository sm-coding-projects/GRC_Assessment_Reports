# ─────────────────────────────────────────────────────
# Local development (SQLite — no external services needed)
# ─────────────────────────────────────────────────────
DATABASE_URL="file:./prisma/dev.db"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─────────────────────────────────────────────────────
# Supabase Auth (optional — only needed if you want login/auth)
# To use auth locally, install the Supabase CLI and run: npm run dev:supabase
# Then fill in the keys printed by `supabase start`.
# ─────────────────────────────────────────────────────
# NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ─────────────────────────────────────────────────────
# Production (Supabase PostgreSQL) — uncomment and fill in
# ─────────────────────────────────────────────────────
# DATABASE_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"
# DIRECT_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"
# NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Upstash Redis (rate limiting — optional in dev, required in production)
# UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="your-upstash-token"
